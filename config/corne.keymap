
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define QWERTY	0
#define DVORAK	1
#define COLEMAK	2
// #define EUCALYN	3
#define FUNC	3
#define NUMB	4
#define OTHER	5

#define COMBO(NAME, TM, POS, BIND) NAME {\
	slow-release; timeout-ms = <TM>;\
	key-positions = POS; bindings = BIND;\
}

#define MACRO(NAME, ...) NAME: NAME {\
	compatible = "zmk,behavior-macro";\
	#binding-cells = <0>; bindings = __VA_ARGS__;\
}

#define MACRO_ONE_PARAM(NAME, ...) NAME: NAME {\
	compatible = "zmk,behavior-macro-one-param";\
	#binding-cells = <1>; bindings = __VA_ARGS__;\
}

#define MACRO_TWO_PARAM(NAME, ...) NAME: NAME {\
	compatible = "zmk,behavior-macro-two-param";\
	#binding-cells = <2>; bindings = __VA_ARGS__;\
}

#define TAP_DANCE(NAME, TERM, ...) NAME: NAME {\
	compatible = "zmk,behavior-tap-dance";\
	#binding-cells = <0>; tapping-term-ms = <TERM>; bindings = __VA_ARGS__;\
}

&lt { flavor = "hold-preferred"; };
&mt { flavor = "hold-preferred"; quick-tap-ms = <300>; };

/ {
	behaviors {
		
		MACRO(mkp_2mb1, <&macro_tap &mkp MB1 &mkp MB1>);
		MACRO(mkp_3mb1, <&macro_tap &mkp MB1 &mkp MB1 &mkp MB1>);
		
		MACRO(half, <&macro_tap &kp INT2 &kp GRAVE>);
		MACRO(home, <&macro_tap &kp A &kp S &kp D &kp F &kp SEMI &kp L &kp K &kp J>);

		MACRO_ONE_PARAM(bt_clr
			, <&macro_param_1to2>
			, <&macro_tap &bt BT_SEL MACRO_PLACEHOLDER>
			, <&macro_tap &bt BT_CLR>
		);

		MACRO_TWO_PARAM(hkp
			, <&macro_param_1to1>, <&macro_press &kp MACRO_PLACEHOLDER>
			, <&macro_param_2to1>, <&macro_press &kp MACRO_PLACEHOLDER>
			, <&macro_pause_for_release>
			, <&macro_param_2to1>, <&macro_release &kp MACRO_PLACEHOLDER>
			, <&macro_param_1to1>, <&macro_release &kp MACRO_PLACEHOLDER>
		);

		// TAP_DANCE(td_grave, 300, <&half>, <&kp INT2>);
		// TAP_DANCE(td_tab, 300, <&kp TAB>, <&hkp LSHFT TAB>);
		// TAP_DANCE(td_bt0, 300, <&bt BT_SEL 0>, <&bt_clr 0>);
		// TAP_DANCE(td_bt1, 300, <&bt BT_SEL 1>, <&bt_clr 1>);
		// TAP_DANCE(td_bt2, 300, <&bt BT_SEL 2>, <&bt_clr 2>);
		// TAP_DANCE(td_bt3, 300, <&bt BT_SEL 3>, <&bt_clr 3>);
		// TAP_DANCE(td_bt4, 300, <&bt BT_SEL 4>, <&bt_clr 4>);
		// TAP_DANCE(td_base, 1000, <&to QWERTY>, <&to DVORAK>, <&to COLEMAK>);
		// TAP_DANCE(td_base, 1000, <&to QWERTY>, <&to DVORAK>, <&to COLEMAK>, <&to EUCALYN>);
	};
	
	keymap {
		
		compatible = "zmk,keymap";
		qwerty {
			bindings = <
				&trans	&kp Q	&kp W			&kp E			&kp R			&kp T			&kp Y			&kp U	&kp I		&kp O		&kp P		&trans
				&trans	&kp A	&kp S			&kp D			&kp F			&kp G			&kp H			&kp J	&kp K		&kp L		&kp SEMI	&trans
				&trans	&kp Z	&kp X			&kp C			&kp V			&kp B			&kp N			&kp M	&kp COMMA	&kp DOT		&kp SLASH	&trans
										&mt LCTRL LS(CAPSLOCK)	&mt LSHFT INT2	&mt LALT ESC	&lt CTRL TAB	&lt NUMB SPACE	&lt FUNC ENTER
			>;
		};
		dvorak {
			bindings = <
				&trans	&kp SLASH	&kp COMMA	&kp DOT		&kp P	&kp Y	&kp F	&kp G	&kp C	&kp R	&kp L	&trans
				&trans	&kp A		&kp O		&kp E		&kp U	&kp I	&kp D	&kp H	&kp T	&kp N	&kp S	&trans
				&trans	&kp SEMI	&kp Q		&kp J		&kp K	&kp X	&kp B	&kp M	&kp W	&kp V	&kp Z	&trans
												&trans		&trans	&trans	&trans	&trans	&trans
			>;
		};
		colemak {
			bindings = <
				&trans	&kp Q	&kp W	&kp F	&kp P	&kp G	&kp J	&kp L	&kp U		&kp Y	&kp SEMI	&trans
				&trans	&kp A	&kp R	&kp S	&kp T	&kp D	&kp H	&kp N	&kp E		&kp I	&kp O		&trans
				&trans	&kp Z	&kp X	&kp C	&kp V	&kp B	&kp K	&kp M	&kp COMMA	&kp DOT	&kp SLASH	&trans
										&trans	&trans	&trans	&trans	&trans	&trans
			>;
		};
		// eucalyn {
		// 	bindings = <
		// 		&trans	&kp Q	&kp W	&kp COMMA	&kp DOT		&kp SEMI	&kp M	&kp R	&kp D	&kp Y	&kp P		&trans
		// 		&trans	&kp A	&kp O	&kp E		&kp I		&kp U		&kp G	&kp T	&kp K	&kp S	&kp N		&trans
		// 		&trans	&kp Z	&kp X	&kp C		&kp V		&kp F		&kp B	&kp H	&kp J	&kp L	&kp SLASH	&trans
		// 						&trans	&trans		&trans		&trans		&trans	&trans
		// 	>;
		// };
		function {
			bindings = <
				&trans	&kp GRAVE	&kp F2		&kp F3				&kp F4		&kp F5		&kp MINUS	&kp EQUAL	&kp INT3	&kp BSPC	&kp INS		&trans
				&trans	&kp F6		&kp F7		&kp F8				&kp F9		&kp F10		&none		&none		&none		&none		&kp DEL		&trans
				&trans	&kp PSCRN	&kp SLCK	&kp PAUSE_BREAK		&kp F11		&kp F12		&none		&kp INT5	&none		&kp INT4	&kp K_APP	&trans
									&trans		&trans			&trans		&trans		&trans		&trans
			>;
		};
		number {
			bindings = <
				&trans	&kp N1			&kp N2				&kp N3			&kp N4			&kp N5			&hkp LSHFT N1	&hkp LSHFT N2	&hkp LSHFT N3	&hkp LSHFT N4	&hkp LSHFT N5	&trans
				&trans	&kp N6			&kp N7				&kp N8			&kp N9			&kp N0			&hkp LSHFT N6	&hkp LSHFT N7	&hkp LSHFT N8	&hkp LSHFT N9	&kp SQT			&trans
				&trans	&kp KP_SLASH	&kp KP_ASTERISK		&kp KP_MINUS	&kp KP_PLUS		&kp KP_DOT		&none			&kp LBKT		&kp RBKT		&kp NUHS		&kp INT1		&trans
										&trans				&trans			&trans			&trans			&trans		&trans
			>;
		};
		other {
			bindings = <
				&trans	&kp C_VOL_UP	&hkp RC(RGUI) LEFT	&hkp RGUI UP	&hkp RC(RGUI) RIGHT		&none			&none	&kp PG_UP	&kp UP		&kp PG_DN	&none	&trans
				&trans	&kp C_VOL_DN	&hkp RGUI LEFT		&hkp RGUI DOWN	&hkp RGUI RIGHT			&none			&none	&kp LEFT	&kp DOWN	&kp RIGHT	&none	&trans
				&trans	&kp C_MUTE		&none				&none			&none					&none			&none	&kp HOME	&none		&kp END		&none	&trans
										&trans				&trans			&trans					&trans			&trans	&trans
			>;
		};
	};
	
	combos {
		
		compatible = "zmk,combos";
		
		COMBO(bootloader, 35, <0 12 24>, <&bootloader>);
		// COMBO(out_tog, 35, <0 1>, <&out OUT_TOG>);
		COMBO(bt_sel_0, 35, <6 18>,   <&bt BT_SEL 0>);
		COMBO(bt_sel_1, 35, <7 19>,   <&bt BT_SEL 1>);
		COMBO(bt_sel_2, 35, <8 20>,   <&bt BT_SEL 2>);
		COMBO(bt_sel_3, 35, <9 21>,   <&bt BT_SEL 3>);
		COMBO(bt_sel_4, 35, <10 22>,   <&bt BT_SEL 4>);
		COMBO(bt_clr,   35, <10 22 34>, <&bt BT_CLR>);
		COMBO(out_tog,  35, <6 18 30>, <&out OUT_TOG>);
		
		COMBO(single_mb1, 35, <19 20>, <&mkp MB1>);	
		COMBO(single_mb2, 35, <20 21>, <&mkp MB2>);
		COMBO(single_mb4, 35, <31 32>, <&mkp MB4>);	
		COMBO(single_mb5, 35, <32 33>, <&mkp MB5>);
		COMBO(double_mb1, 35, <19 20 21>, <&mkp_2mb1>);	
		COMBO(triple_mb1, 35, <31 32 33>, <&mkp_3mb1>);
		COMBO(single_mb3, 35, <19 21>, <&mkp MB3>);	
		// COMBO(mute, 35, <12 24>, <&kp C_MUTE>);

		COMBO(hrm_lctl, 35, <13 14>, <&kp LCTRL>);
		COMBO(hrm_lsht, 35, <14 15>, <&kp LSHFT>);
		COMBO(hrm_lalt, 35, <15 16>, <&kp LALT>);
		COMBO(hrm_lgui, 35, <15 17>, <&kp LGUI>);
		COMBO(hrm_lgui2, 35, <3 4>, <&kp LGUI>);
		COMBO(hrm_lctl_lsht, 35, <13 14 15>, <&kp LC(LSHFT)>);
		COMBO(hrm_lsht_lalt, 35, <14 15 16>, <&kp LS(LALT)>);
		COMBO(hrm_lalt_lgui, 35, <16 17>, <&kp LA(LGUI)>);
		COMBO(hrm_lsht_lgui, 35, <14 17>, <&kp LS(LGUI)>);
		COMBO(hrm_lctl_lgui, 35, <13 17>, <&kp LC(LGUI)>);
		COMBO(hrm_lctl_lalt, 35, <13 16>, <&kp LC(LALT)>);
		COMBO(hrm_lmeh, 35, <13 14 15 16>, <&kp LC(LS(LALT))>);
	};
};
